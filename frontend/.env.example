# OvaCare Frontend Configuration Example
# Copy this file to frontend/.env for local overrides

# Local Development:
# Connects through Vite development proxy or local Flask API
VITE_API_BASE_URL=http://localhost:5000/api

# Production Deployment (Vercel):
# In Vercel Project Settings -> Environment Variables, configure:
# VITE_API_BASE_URL=https://your-ovacare-api.onrender.com/api
