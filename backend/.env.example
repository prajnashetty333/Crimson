# OvaCare Backend — Environment Configuration Example
#
# Copy this file to .env for local development.
# NEVER commit .env to source control — it is listed in .gitignore.
# NEVER put a real secret in this file or in README.md.

# ---------------------------------------------------------------------------
# APP_ENV — controls whether the application runs in development or production.
#
# Allowed values: development | production
#
# The dev fallback secret is ONLY allowed when APP_ENV=development.
# Any other value — including an absent APP_ENV — enforces production-grade
# secret requirements and will abort startup if SECRET_KEY is missing or weak.
# ---------------------------------------------------------------------------
APP_ENV=development

# ---------------------------------------------------------------------------
# SECRET_KEY — required in production; optional when APP_ENV=development.
#
# In local development (APP_ENV=development) you may omit this variable;
# a non-secret development fallback key will be used automatically.
# In all other environments you MUST supply a strong random secret.
#
# Generate one with:
#   python -c "import secrets; print(secrets.token_hex(32))"
#
# The generated value must be at least 32 characters and must not match any
# known placeholder. Set it as an environment variable in your hosting
# provider's dashboard — do NOT paste the real value here.
# ---------------------------------------------------------------------------
SECRET_KEY=

# Authentication token expiry in seconds (default: 604800 = 7 days)
AUTH_TOKEN_MAX_AGE=604800

# CORS: comma-separated list of allowed frontend origins
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Optional: MySQL database (if unset, falls back to local SQLite ovacare.db)
# MYSQL_USER=
# MYSQL_PASSWORD=
# MYSQL_HOST=
# MYSQL_DATABASE=

# ---------------------------------------------------------------------------
# Cloudflare Workers AI — Conversational 3D Companion Configuration
#
# Credentials for Cloudflare Workers AI chat completions.
# Kept strictly server-side. Never exposed to the frontend.
# Obtain from Cloudflare Dashboard -> Workers & AI -> AI.
# ---------------------------------------------------------------------------
CLOUDFLARE_ACCOUNT_ID=your_cloudflare_account_id_here
CLOUDFLARE_API_TOKEN=your_cloudflare_api_token_here
CLOUDFLARE_MODEL=@cf/meta/llama-3.1-8b-instruct-fp8

