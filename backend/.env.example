# OvaCare Backend Configuration Example
# Copy this file to .env and adjust variables as needed

SECRET_KEY=replace-with-a-secure-random-secret-key-in-production
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Optional: MySQL database configuration (if omitted, falls back to local SQLite ovacare.db)
# MYSQL_USER=
# MYSQL_PASSWORD=
# MYSQL_HOST=
# MYSQL_DATABASE=
